[Unit]
Description=Capture bounded PRIVATE canonical future Traffic events for AoE2WAR (no public writes)
Wants=traffic-api.service
After=traffic-api.service
RequiresMountsFor=/mnt/HC_Volume_105319120/traffic-v2-shadow/canary-oocB0WuA

[Service]
Type=oneshot
User=root
Group=tony
# Traffic source DB directory is owned by tony:tony mode 0775; the
# supplementary primary group allows SQLite read-only WAL/SHM coordination
# without restoring CAP_DAC_OVERRIDE. Private root-owned 0600 canary remains
# accessible because User=root owns it.
WorkingDirectory=/var/www/Traffic/traffic-api
Environment=PYTHONUNBUFFERED=1
UMask=0077
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=35%
MemoryHigh=256M
MemoryMax=512M
MemorySwapMax=128M
OOMPolicy=stop
TimeoutStartSec=50s
NoNewPrivileges=yes
# Root remains temporarily necessary for the existing protected root-owned
# private SQLite canary/ledger. Do NOT infer that User=root is safe by itself.
# This forwarder uses local SQLite only and must not reach HD/DE/Wolo finance
# over IP, Unix PostgreSQL sockets, a new network namespace, or capabilities.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
InaccessiblePaths=-/run/postgresql -/var/run/postgresql
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# SQLite WAL mode=ro needs to create ephemeral -wal/-shm coordination files
# when none exist; SQLite unlinks them when the last connection exits.
# Mount only the Traffic source directory for this unavoidable coordination,
# then remount the primary database read-only, as independently verified by
# a same-sandbox VPS probe on 2026-10-20. When present at namespace creation,
# the live -wal data file also receives a read-only bind.
# NOTE: the writable directory exception also permits other sidecar paths;
# the application must *only* use source_connection(...mode=ro/query_only).
# This unit is NOT an audience publisher or general file mutation service.
ReadWritePaths=/mnt/HC_Volume_105319120/traffic-v2-shadow/canary-oocB0WuA /mnt/HC_Volume_105319120/traffic-db
ReadOnlyPaths=/mnt/HC_Volume_105319120/traffic-db/traffic_history.sqlite3 -/mnt/HC_Volume_105319120/traffic-db/traffic_history.sqlite3-wal
ExecStart=/var/www/Traffic/traffic-api/.venv/bin/python3 -m scripts.public_audience_v2_forward_ledger --source /mnt/HC_Volume_105319120/traffic-db/traffic_history.sqlite3 --checkpoint /mnt/HC_Volume_105319120/traffic-v2-shadow/canary-oocB0WuA/checkpoint.sqlite3 --ledger /mnt/HC_Volume_105319120/traffic-v2-shadow/canary-oocB0WuA/future-ledger.sqlite3 --max-rows 3000 --budget-seconds 12 --advance --approve-private-write
