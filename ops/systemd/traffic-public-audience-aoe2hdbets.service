[Unit]
Description=Refresh canonical public Traffic audience archive for AoE2 War
Wants=traffic-api.service
After=traffic-api.service

[Service]
Type=oneshot
User=tony
Group=tony
RuntimeDirectory=traffic-rollups
RuntimeDirectoryMode=0755
WorkingDirectory=/var/www/Traffic/traffic-api
EnvironmentFile=/etc/traffic-api.env
Environment=PYTHONUNBUFFERED=1
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=7200
ExecStart=/usr/bin/flock /run/traffic-rollups/aoe2hdbets.lock /var/www/Traffic/traffic-api/.venv/bin/python3 scripts/rebuild_public_audience_archive.py --apply
