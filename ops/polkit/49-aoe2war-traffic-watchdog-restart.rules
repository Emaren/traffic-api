// C03 Traffic-only delegated restart. Never permit WOLO, Postgres, Steam or HD/DE.
polkit.addRule(function(action, subject) {
    if (subject.user !== "traffic-watchdog" ||
        action.id !== "org.freedesktop.systemd1.manage-units")
        return;
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (verb === "restart" &&
        (unit === "traffic-web.service" || unit === "traffic-api.service"))
        return polkit.Result.YES;
    return;
});
